#Exporting to csv for better readability. 
import os
import csv
from docx import Document

folder = "."

all_files = os.listdir(folder)

docx_files = []
for file in all_files:
    if file.endswith(".docx"):
        docx_files.append(file)

with open("word_output.csv", "w", newline="") as csv_file:
    writer = csv.writer(csv_file)
    writer.writerow(["Filename", "Author", "Title", "Created"])
    
    for docx in docx_files:
        filepath = os.path.join(folder, docx)
        
        doc = Document(filepath)
        core_props = doc.core_properties
        
        if core_props.author:
            author = core_props.author
        else:
            author = "Unknown"
        
        if core_props.title:
            title = core_props.title
        else:
            title = "Unknown"
        
        if core_props.created:
            created = core_props.created
        else:
            created = "Unknown"
        
        writer.writerow([docx, author, title, created])
        print(f"Added: {docx}")

print("\n✅ Done! Results saved to word_output.csv")
